# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public canonical URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: use sk_test_ / whsec_ in sandbox, live values only in production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal sandbox; production base is https://api-m.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=Folio <orders@your-verified-domain.com>

# Long random value used to sign renewable download links
DOWNLOAD_TOKEN_SECRET=

# Absolute server-only directory or mounted private object-storage path
# Files use stable keys such as book-deep-work.pdf and must never be in /public
PRIVATE_EBOOK_DIR=/secure/folio-ebooks
