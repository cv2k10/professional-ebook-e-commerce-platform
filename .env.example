# Copy to .env for local development (`npm run dev`). In production, set the
# secrets below as Worker secrets; only names declared in cloudflare.config.ts
# reach the Worker. D1 (DB) and R2 (EBOOKS) are bindings, not env vars.

# Public canonical URL (no trailing slash); inlined into the build
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Long random value used to sign download links (e.g. `openssl rand -hex 32`)
DOWNLOAD_TOKEN_SECRET=

# Stripe: use sk_test_ / whsec_ in sandbox, live values only in production
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal sandbox; PAYPAL_API_BASE defaults to sandbox in cloudflare.config.ts
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Resend transactional email
RESEND_API_KEY=
EMAIL_FROM=Folio <orders@your-verified-domain.com>
